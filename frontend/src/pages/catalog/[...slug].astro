---
import { ProductPage } from "../../components/ProductPage";
import SeoMeta from "../../components/SeoMeta.astro";
import { loadCatalogProductBySlug } from "../../lib/backend-api";
import GlobalPreloader from "../../components/GlobalPreloader.astro";
import { getConfiguredOrigin } from "../../lib/site-url";
import { truncateSeoDescription } from "../../lib/seo";
import "../../styles/global.css";

export const prerender = false;

const slugParam = Astro.params.slug;
const slug = Array.isArray(slugParam) ? slugParam.join("/") : slugParam ?? "";
let product;
let relatedProducts = [];
let allProducts = [];

try {
  const result = await loadCatalogProductBySlug(slug);
  product = result.product;
  relatedProducts = result.relatedProducts;
  allProducts = result.allProducts ?? [];
} catch {
  return Astro.redirect("/catalog");
}

function normalizeText(value: string) {
  return value.replace(/\s+/g, " ").trim();
}

function buildAutoDescription() {
  const descriptionParts = Array.isArray(product.description) ? product.description : [];
  const base =
    descriptionParts.find((item) => normalizeText(item).length > 0) ??
    [product.title, product.brandLabel, product.category, product.type].filter(Boolean).join(". ");
  const normalized = normalizeText(base);

  if (normalized.length <= 170) {
    return normalized;
  }

  return `${normalized.slice(0, 167).trimEnd()}...`;
}

function buildAutoKeywords() {
  const values = [
    product.title,
    product.category,
    product.type,
    product.brandLabel,
    product.article,
  ]
    .map((item) => normalizeText(item ?? ""))
    .filter(Boolean);

  return Array.from(new Set(values)).join(", ");
}

const pageTitle = normalizeText(product.metaTitle ?? product.title);
const pageDescription = truncateSeoDescription(product.metaDescription ?? buildAutoDescription());
const pageKeywords = normalizeText(buildAutoKeywords());
const canonicalUrl = `${getConfiguredOrigin(Astro.site)}${Astro.url.pathname}`;
const origin = getConfiguredOrigin(Astro.site);
const productImage = product.image?.startsWith("http") ? product.image : `${origin}${product.image}`;
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.title,
  image: product.gallery?.length ? product.gallery.map((value) => (value.startsWith("http") ? value : `${origin}${value}`)) : [productImage],
  description: Array.isArray(product.description) ? product.description.join(" ") : pageDescription,
  sku: product.article,
  brand: { "@type": "Brand", name: product.brandLabel || product.brand },
  offers: {
    "@type": "Offer",
    url: canonicalUrl,
    price: String(product.price),
    priceCurrency: "RUB",
    availability:
      typeof product.stock === "number"
        ? product.stock > 0
          ? "https://schema.org/InStock"
          : "https://schema.org/OutOfStock"
        : "https://schema.org/InStock",
  },
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/png" href="/icons/climatrade-app-icon.png" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <SeoMeta
      title={pageTitle}
      description={pageDescription}
      keywords={pageKeywords}
      canonicalUrl={canonicalUrl}
      ogType="product"
      ogImagePath={product.image}
      schemas={[productSchema]}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=DM+Sans:wght@400;500&family=Jaldi:wght@400;700&family=JetBrains+Mono:wght@400&family=Manrope:wght@200;400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <GlobalPreloader />
    <ProductPage client:load product={product} relatedProducts={relatedProducts} allProducts={allProducts} />
  </body>
</html>
